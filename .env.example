# Sao chép file này thành .env rồi điền giá trị. KHÔNG commit file .env.

# --- Bắt buộc (để trống, bạn điền sau) ---
ZALO_BOT_TOKEN=
GEMINI_API_KEY=

# Model Gemini. Xác nhận ID đúng trên Google AI Studio.
GEMINI_MODEL=gemini-3.1-flash-lite

# ID Zalo của chủ bot (người được dùng /mode, /allow, /deny...).
# Chưa biết thì để trống, chạy bot rồi nhắn cho bot: log sẽ in from_id của bạn.
OWNER_ZALO_ID=

# Danh sách chat.id được phép dùng bot ngay khi khởi động, cách nhau bởi dấu phẩy.
# Có thể để trống và thêm sau bằng lệnh /allow gõ trong nhóm, hoặc ở trang Nhóm của giao diện.
ALLOWED_CHAT_IDS=

# Tin nhắn trong nhóm ở chế độ "default" chỉ được trả lời khi bắt đầu bằng
# một trong các từ gọi bot này (cách nhau bởi dấu phẩy, không phân biệt hoa thường).
BOT_TRIGGERS=/bot
# Tin trong nhóm nhắc tới một trong các tên này (không phân biệt hoa thường, có dấu hay không)
# hoặc @tag acc bot thì bot trả lời luôn, không cần /bot. Tên acc Zalo của bot được tự thêm. Để trống để tắt.
BOT_NAMES=bot

# --- Bộ lọc tin nhóm & memorydata ---
# Mọi tin của từng cuộc trò chuyện được ghi vào data/memorydata/<chat>.txt (mỗi dòng một JSON).
# Chỉ tin qua bộ lọc mới vào session (ngữ cảnh gửi Gemini). Bộ lọc: /bot, @tag, gọi tên -> qua;
# cảm thán/sticker -> chặn; còn lại hỏi Gemini "tin này có nhờ bot không?" (FILTER_AI=true).
FILTER_AI=true
# Model cho bộ lọc (để trống = GEMINI_MODEL; nên dùng model rẻ, nhanh)
FILTER_MODEL=
# Số tin gần nhất đưa cho bộ lọc để hiểu câu hỏi tiếp nối
FILTER_CONTEXT_LINES=6
# Số tin tối đa giữ lại mỗi file memorydata (0 = không giới hạn)
MEMORYDATA_KEEP=5000

# --- Web Quản lý thời gian (quanlythoigian) ---
# Bot thêm lịch hẹn / việc cần làm vào web khi được nhờ. Khoá lấy ở web: Cài đặt → Kết nối AI agent → Tạo khoá cho agent.
SCHEDULE_API_URL=https://quanlythoigian-azure.vercel.app
SCHEDULE_API_KEY=
# true: chỉ chủ bot (OWNER_ZALO_ID) được nhờ thêm/xem lịch
SCHEDULE_OWNER_ONLY=true

# --- Nhận tin ---
# polling (mặc định, không cần domain), webhook (cần URL HTTPS công khai)
# hoặc personal (chạy trên acc Zalo cá nhân đăng nhập bằng mã QR, không cần ZALO_BOT_TOKEN)
RECEIVE_MODE=polling
# Chỉ dùng khi RECEIVE_MODE=personal. Đăng nhập acc phụ bằng mã QR: `python -m bot zalo-login`
# (hoặc giao diện quản lý → Cài đặt). Phiên đăng nhập lưu ở file dưới đây, không cần điền gì thêm.
# ZALO_SESSION_FILE=data/zalo_session.json
# Chỉ dùng khi RECEIVE_MODE=webhook
WEBHOOK_SECRET=
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8080

# --- Giao diện quản lý (python -m bot admin) ---
# Mã truy cập giao diện. Để trống thì lần đầu chạy `python -m bot admin` sẽ tự tạo và ghi vào .env.
ADMIN_TOKEN=
ADMIN_PORT=8081
# Hiện trang Hội thoại (đọc được nội dung chat trong nhóm)
ADMIN_SHOW_HISTORY=true

# --- Thư mục ---
DATA_DIR=data
WORKSPACE_DIR=workspace
LOG_DIR=logs
LOG_LEVEL=INFO

# --- Giới hạn ---
# Số lượt hội thoại gần nhất đưa vào prompt
HISTORY_TURNS=20
# Số vòng gọi tool tối đa trong một lượt trả lời
MAX_TOOL_ROUNDS=4
# Số token đầu ra tối đa mỗi câu trả lời
MAX_OUTPUT_TOKENS=1024
# Thời gian chờ Gemini tối đa (giây)
LLM_TIMEOUT_SECONDS=60
# Số tin tối đa mỗi phút được bot xử lý, theo người và theo nhóm
USER_RATE_PER_MIN=6
CHAT_RATE_PER_MIN=20
# Hạn mức token mỗi ngày (giờ Việt Nam). Vượt thì nhóm ở chế độ "all"
# tạm chuyển về "default" đến hết ngày. 0 = không giới hạn.
DAILY_TOKEN_BUDGET=200000
