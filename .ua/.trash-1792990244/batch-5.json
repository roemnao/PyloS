   "id": "file:src/bot/core/mention_tags.py",
   "type": "file",
   "name": "mention_tags.py",
   "filePath": "src/bot/core/mention_tags.py",
   "summary": "Handles @mention tagging in Zalo group replies: inserts missing '@' before member names when the requester asked to tag someone, and converts '@Name' text into Zalo mention objects with UTF-16 positions using accent-insensitive, longest-first matching.",
   "tags": [
    "mention",
    "text-processing",
    "utility",
    "unicode"
   ],
   "complexity": "moderate",
   "languageNotes": "Uses same-length diacritic folding so character offsets stay valid, and UTF-16 length counting to match the offsets Zalo (JavaScript) expects."
  },
  {
   "id": "function:src/bot/core/mention_tags.py:fold_same_length",
   "type": "function",
   "name": "fold_same_length",
   "filePath": "src/bot/core/mention_tags.py",
   "lineRange": [
    28,
    30
   ],
   "summary": "Strips Vietnamese diacritics and lowercases text while preserving length so match positions map back to the original string.",
   "tags": [
    "utility",
    "unicode",
    "text-processing"
   ],
   "complexity": "simple"
  },
  {
