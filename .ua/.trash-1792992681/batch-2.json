{"nodes":[{"id":"file:src/bot/agent/tools/assign_events.py","type":"file","name":"assign_events.py","filePath":"src/bot/agent/tools/assign_events.py","summary":"Agent tool module that lets the bot assign, update, cancel and list calendar events for people mentioned in a Zalo group, delegating to an external schedule web app via server_client. Resolves recipients from @mentions or accent-insensitive name matching and remembers assigned events in a JSONL file.","tags":["agent-tool","calendar","scheduling","api-client"],"complexity":"complex"},{"id":"function:src/bot/agent/tools/assign_events.py:match_member","type":"function","name":"match_member","filePath":"src/bot/agent/tools/assign_events.py","lineRange":[44,54],"summary":"Matches a name against a chat member map using accent-insensitive exact, whole-word, then prefix comparison and returns the matching user IDs.","tags":["utility","name-matching"],"complexity":"simple"},{"id":"function:src/bot/agent/tools/assign_events.py:resolve_people","type":"function","name":"resolve_people","filePath":"src/bot/agent/tools/assign_events.py","lineRange":[57,92],"summary":"Resolves event recipients from real @mentions first, then names and teams, returning the resolved {zaloUid,name} list plus unresolved names.","tags":["recipient-resolution","mentions"],"complexity":"moderate"},{"id":"function:src/bot/agent/tools/assign_events.py:_assign","type":"function","name":"_assign","filePath":"src/bot/agent/tools/assign_events.py","lineRange":[195,220],"summary":"Tool handler that creates an event via the schedule web API for the resolved recipients, enforcing role permissions, and records it locally.","tags":["tool-handler","api-client"],"complexity":"moderate"},{"id":"function:src/bot/agent/tools/assign_events.py:_update","type":"function","name":"_update","filePath":"src/bot/agent/tools/assign_events.py","lineRange":[223,248],"summary":"Tool handler that patches a previously assigned event (time, title, add/remove recipients), defaulting to the most recent event in the chat.","tags":["tool-handler","api-client"],"complexity":"moderate"},{"id":"function:src/bot/agent/tools/assign_events.py:_tools","type":"function","name":"_tools","filePath":"src/bot/agent/tools/assign_events.py","lineRange":[322,384],"summary":"Builds the Tool definitions (giao_lich, sua_lich, huy_lich, lich_cua_toi, lich_da_giao) with JSON schemas, returning none when the schedule server is not configured.","tags":["tool-registry","schema"],"complexity":"moderate"},{"id":"file:src/bot/agent/tools/read_chat_memory.py","type":"file","name":"read_chat_memory.py","filePath":"src/bot/agent/tools/read_chat_memory.py","summary":"Agent tool that lets the model re-read recent raw messages of the current conversation from memorydata, optionally filtered by keyword. The chat id comes from the tool context so other conversations cannot be read.","tags":["agent-tool","chat-memory","security"],"complexity":"simple"},{"id":"function:src/bot/agent/tools/read_chat_memory.py:_read","type":"function","name":"_read","filePath":"src/bot/agent/tools/read_chat_memory.py","lineRange":[23,45],"summary":"Handler that loads recent memory records for the current chat, filters by accent-folded keyword, and formats them with Vietnam-time stamps and a note marking them as data only.","tags":["tool-handler","chat-history"],"complexity":"simple"},{"id":"file:src/bot/core/message_filter.py","type":"file","name":"message_filter.py","filePath":"src/bot/core/message_filter.py","summary":"Layered message filter deciding whether a Zalo message is addressed to the bot, using rules (private chat, /bot, mention, name call), group mode and token budget, and finally an AI classification.","tags":["filter","routing","gemini","decision-logic"],"complexity":"moderate"},{"id":"class:src/bot/core/message_filter.py:Decision","type":"class","name":"Decision","filePath":"src/bot/core/message_filter.py","lineRange":[51,59],"summary":"Dataclass holding a filter verdict (reply flag, reason, layer) with a method to convert it into a log record.","tags":["data-model","dataclass"],"complexity":"simple"},{"id":"class:src/bot/core/message_filter.py:MessageFilter","type":"class","name":"MessageFilter","filePath":"src/bot/core/message_filter.py","lineRange":[67,154],"summary":"Applies the filter tiers to incoming messages: strips triggers and self-mentions, detects calls to the bot, and asks the AI to decide in all-mode groups.","tags":["filter","ai-classifier"],"complexity":"moderate"},{"id":"file:src/bot/core/message_handler.py","type":"file","name":"message_handler.py","filePath":"src/bot/core/message_handler.py","summary":"Core Bot orchestrator that receives Zalo payloads, applies filtering, roles, rate limiting and budgets, queues jobs per chat, runs the agent, and sends chunked replies with mention tags.","tags":["orchestrator","message-handling","queue","core"],"complexity":"complex"},{"id":"class:src/bot/core/message_handler.py:ZaloSender","type":"class","name":"ZaloSender","filePath":"src/bot/core/message_handler.py","lineRange":[65,67],"summary":"Protocol describing the Zalo sending interface (send_message, send_chat_action) that the bot depends on.","tags":["protocol","interface"],"complexity":"simple"},{"id":"class:src/bot/core/message_handler.py:Job","type":"class","name":"Job","filePath":"src/bot/core/message_handler.py","lineRange":[71,72],"summary":"Dataclass representing a queued message-processing job.","tags":["data-model","queue"],"complexity":"simple"},{"id":"class:src/bot/core/message_handler.py:Bot","type":"class","name":"Bot","filePath":"src/bot/core/message_handler.py","lineRange":[75,442],"summary":"Main bot class: handles payloads, owner commands, filtering, per-chat worker queues, agent calls, usage tracking and replies, with drain/stop lifecycle control.","tags":["orchestrator","async","lifecycle"],"complexity":"complex"},{"id":"function:src/bot/core/message_handler.py:strip_name_prefix","type":"function","name":"strip_name_prefix","filePath":"src/bot/core/message_handler.py","lineRange":[445,451],"summary":"Removes a leading bot-name prefix from a line of text.","tags":["utility","text-processing"],"complexity":"simple"},{"id":"file:src/bot/core/owner_commands.py","type":"file","name":"owner_commands.py","filePath":"src/bot/core/owner_commands.py","summary":"Parses and executes in-chat slash commands (help, mode, allow, deny, status, reset, leader, team, role) gated by user role, operating on group, history and usage stores.","tags":["commands","permissions","chat-bot"],"complexity":"moderate"},{"id":"function:src/bot/core/owner_commands.py:help_text","type":"function","name":"help_text","filePath":"src/bot/core/owner_commands.py","lineRange":[38,40],"summary":"Renders the list of commands available to a given role.","tags":["help","formatting"],"complexity":"simple"},{"id":"function:src/bot/core/owner_commands.py:parse_command","type":"function","name":"parse_command","filePath":"src/bot/core/owner_commands.py","lineRange":[49,59],"summary":"Parses a message into a ParsedCommand if it starts with a known slash command.","tags":["parser","commands"],"complexity":"simple"},{"id":"function:src/bot/core/owner_commands.py:describe_mode","type":"function","name":"describe_mode","filePath":"src/bot/core/owner_commands.py","lineRange":[62,65],"summary":"Returns a human-readable description of a group filter mode.","tags":["formatting","commands"],"complexity":"simple"},{"id":"class:src/bot/core/owner_commands.py:ParsedCommand","type":"class","name":"ParsedCommand","filePath":"src/bot/core/owner_commands.py","lineRange":[44,46],"summary":"Dataclass for a parsed command name and its arguments.","tags":["data-model","dataclass"],"complexity":"simple"},{"id":"class:src/bot/core/owner_commands.py:CommandHandler","type":"class","name":"CommandHandler","filePath":"src/bot/core/owner_commands.py","lineRange":[68,221],"summary":"Executes parsed commands after checking role requirements, updating group state, leaders, teams and resetting history.","tags":["command-handler","permissions"],"complexity":"moderate"},{"id":"function:src/bot/core/owner_commands.py:_pick_people","type":"function","name":"_pick_people","filePath":"src/bot/core/owner_commands.py","lineRange":[224,241],"summary":"Selects people from mentions or names in a command message for leader/team operations.","tags":["helper","mentions"],"complexity":"simple"},{"id":"file:src/bot/core/rate_limiter.py","type":"file","name":"rate_limiter.py","filePath":"src/bot/core/rate_limiter.py","summary":"In-memory sliding-window rate limiter limiting messages per minute per key.","tags":["rate-limiting","utility","core"],"complexity":"simple"},{"id":"class:src/bot/core/rate_limiter.py:RateLimiter","type":"class","name":"RateLimiter","filePath":"src/bot/core/rate_limiter.py","lineRange":[10,27],"summary":"Tracks per-key hit timestamps in a deque and allows or rejects within a 60-second window; zero disables limiting.","tags":["rate-limiting","sliding-window"],"complexity":"simple"},{"id":"file:src/bot/core/reply_formatting.py","type":"file","name":"reply_formatting.py","filePath":"src/bot/core/reply_formatting.py","summary":"Reply text helpers: UTF-16 length counting, splitting long messages into chunks, and converting markdown to plain text for Zalo.","tags":["formatting","utility","text-processing"],"complexity":"simple"},{"id":"function:src/bot/core/reply_formatting.py:split_message","type":"function","name":"split_message","filePath":"src/bot/core/reply_formatting.py","lineRange":[25,43],"summary":"Splits a long reply into chunks under a UTF-16 length limit, preferring natural break points.","tags":["utility","chunking"],"complexity":"simple"},{"id":"file:src/bot/core/roles.py","type":"file","name":"roles.py","filePath":"src/bot/core/roles.py","summary":"Defines the basic < leader < owner role hierarchy with labels, role lookup per chat, and permission checks for commands.","tags":["roles","permissions","authorization"],"complexity":"simple"},{"id":"function:src/bot/core/roles.py:role_of","type":"function","name":"role_of","filePath":"src/bot/core/roles.py","lineRange":[24,30],"summary":"Determines a user role (owner, group leader or basic) in a chat.","tags":["authorization","roles"],"complexity":"simple"},{"id":"function:src/bot/core/roles.py:required_role","type":"function","name":"required_role","filePath":"src/bot/core/roles.py","lineRange":[33,49],"summary":"Maps a command name and arguments to the minimum role required.","tags":["authorization","commands"],"complexity":"simple"},{"id":"file:src/bot/core/text_fold.py","type":"file","name":"text_fold.py","filePath":"src/bot/core/text_fold.py","summary":"Tiny helper that folds Vietnamese text to lowercase accent-free form for matching.","tags":["utility","text-normalization","vietnamese"],"complexity":"simple"},{"id":"file:src/bot/storage/__init__.py","type":"file","name":"__init__.py","filePath":"src/bot/storage/__init__.py","summary":"Storage package barrel re-exporting data stores and text file helpers.","tags":["barrel","storage","entry-point"],"complexity":"simple"},{"id":"file:src/bot/storage/data_stores.py","type":"file","name":"data_stores.py","filePath":"src/bot/storage/data_stores.py","summary":"Persistent per-chat stores for group state, seen messages, history, memory data, usage, stats, activity and failed messages, built on JSONL/JSON files.","tags":["storage","persistence","data-model","state"],"complexity":"complex"},{"id":"class:src/bot/storage/data_stores.py:GroupStore","type":"class","name":"GroupStore","filePath":"src/bot/storage/data_stores.py","lineRange":[60,194],"summary":"File-backed store of group state (allowed, mode, label, leaders, teams) with mtime-based reload and leader/assign permission checks.","tags":["storage","group-state"],"complexity":"moderate"},{"id":"class:src/bot/storage/data_stores.py:HistoryStore","type":"class","name":"HistoryStore","filePath":"src/bot/storage/data_stores.py","lineRange":[233,253],"summary":"Per-chat conversation history stored as JSONL with append, recent and clear.","tags":["storage","history"],"complexity":"simple"},{"id":"class:src/bot/storage/data_stores.py:MemoryDataStore","type":"class","name":"MemoryDataStore","filePath":"src/bot/storage/data_stores.py","lineRange":[256,289],"summary":"Records all messages of a chat (user and model) for later recall by the memory tool.","tags":["storage","chat-memory"],"complexity":"simple"},{"id":"class:src/bot/storage/data_stores.py:UsageStore","type":"class","name":"UsageStore","filePath":"src/bot/storage/data_stores.py","lineRange":[304,336],"summary":"Tracks daily token usage per chat and a notified flag for budget limits.","tags":["storage","usage","budget"],"complexity":"simple"},{"id":"class:src/bot/storage/data_stores.py:FailedStore","type":"class","name":"FailedStore","filePath":"src/bot/storage/data_stores.py","lineRange":[390,415],"summary":"Queue of failed messages that can be listed pending and marked done.","tags":["storage","retry"],"complexity":"simple"},{"id":"file:src/bot/storage/text_files.py","type":"file","name":"text_files.py","filePath":"src/bot/storage/text_files.py","summary":"Low-level file helpers: atomic text writing and JSONL / JSON object file wrappers with append, tail, trim and rewrite.","tags":["storage","file-io","utility"],"complexity":"moderate"},{"id":"function:src/bot/storage/text_files.py:atomic_write_text","type":"function","name":"atomic_write_text","filePath":"src/bot/storage/text_files.py","lineRange":[21,37],"summary":"Writes text to a temp file and atomically replaces the target to avoid partial writes.","tags":["file-io","atomic"],"complexity":"simple"},{"id":"class:src/bot/storage/text_files.py:JsonLinesFile","type":"class","name":"JsonLinesFile","filePath":"src/bot/storage/text_files.py","lineRange":[40,90],"summary":"Wrapper around a JSON Lines file offering read_all, append, rewrite, tail, count and trim.","tags":["storage","jsonl"],"complexity":"moderate"},{"id":"class:src/bot/storage/text_files.py:JsonObjectFile","type":"class","name":"JsonObjectFile","filePath":"src/bot/storage/text_files.py","lineRange":[93,112],"summary":"Wrapper around a single JSON object file with read and atomic write.","tags":["storage","json"],"complexity":"simple"},{"id":"file:src/bot/zalo/receive_webhook.py","type":"file","name":"receive_webhook.py","filePath":"src/bot/zalo/receive_webhook.py","summary":"FastAPI webhook receiver for Zalo that validates the secret-token header and queues messages for handling, replying immediately.","tags":["webhook","fastapi","api-handler","security"],"complexity":"simple"},{"id":"function:src/bot/zalo/receive_webhook.py:create_app","type":"function","name":"create_app","filePath":"src/bot/zalo/receive_webhook.py","lineRange":[24,44],"summary":"Creates the FastAPI app with the Zalo webhook route, verifying the secret header with constant-time compare and dispatching payloads to the handler.","tags":["fastapi","api-handler"],"complexity":"simple"}],"edges":[{"source":"file:src/bot/agent/tools/assign_events.py","target":"function:src/bot/agent/tools/assign_events.py:match_member","type":"contains","direction":"forward","weight":1},{"source":"file:src/bot/agent/tools/assign_events.py","target":"function:src/bot/agent/tools/assign_events.py:resolve_people","type":"contains","direction":"forward","weight":1},{"source":"file:src/bot/agent/tools/assign_events.py","target":"function:src/bot/agent/tools/assign_events.py:_assign","type":"contains","direction":"forward","weight":1},{"source":"file:src/bot/agent/tools/assign_events.py","target":"function:src/bot/agent/tools/assign_events.py:_update","type":"contains","direction":"forward","weight":1},{"source":"file:src/bot/agent/tools/assign_events.py","target":"function:src/bot/agent/tools/assign_events.py:_tools","type":"contains","direction":"forward","weight":1},{"source":"file:src/bot/agent/tools/read_chat_memory.py","tar