{"nodes":[{"id":"file:src/bot/config.py","type":"file","name":"config.py","filePath":"src/bot/config.py","summary":"Loads bot Settings from environment variables and the settings.env file, with typed helpers and validation errors surfaced as user-readable messages.","tags":["configuration","settings","environment","dataclass"],"complexity":"complex"},{"id":"file:src/bot/storage/process_lock.py","type":"file","name":"process_lock.py","filePath":"src/bot/storage/process_lock.py","summary":"Single-instance file lock preventing two bot processes from running on the same data directory.","tags":["lock","process-management","storage"],"complexity":"simple"},{"id":"file:src/bot/system/__init__.py","type":"file","name":"__init__.py","filePath":"src/bot/system/__init__.py","summary":"Package marker for the system subpackage.","tags":["package","barrel","system"],"complexity":"simple"},{"id":"file:src/bot/system/auto_update.py","type":"file","name":"auto_update.py","filePath":"src/bot/system/auto_update.py","summary":"Source-install auto-updater: checks pending git commits, runs git pull, reinstalls dependencies when needed and reports the result.","tags":["auto-update","git","system","utility"],"complexity":"moderate"},{"id":"file:src/bot/system/bot_process.py","type":"file","name":"bot_process.py","filePath":"src/bot/system/bot_process.py","summary":"Manages background bot and admin processes using lock and PID files, systemd on VPS, standby flags and status reporting shared by CLI and web UI.","tags":["process-management","service","systemd","status"],"complexity":"complex"},{"id":"file:src/bot/system/first_run_setup.py","type":"file","name":"first_run_setup.py","filePath":"src/bot/system/first_run_setup.py","summary":"First-run preparation of the userdata directory, creating missing folders and template files and generating a random admin token.","tags":["setup","onboarding","security","utility"],"complexity":"simple"},{"id":"file:src/bot/system/handover.py","type":"file"